{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build",
        "buildCommand": "npm run vercel-build"
      }
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/hello", "destination": "/api/hello.js" },
    { "source": "/api/tasks", "destination": "/api/tasks.js" },
    { "source": "/api/tasks/:id", "destination": "/api/tasks/[id].js" },
    { "source": "/api/journal", "destination": "/api/journal.js" },
    { "source": "/api/journal/:id", "destination": "/api/journal/[id].js" },
    { "source": "/api/workspaces", "destination": "/api/workspaces/index.js" },
    { "source": "/api/workspaces/:id", "destination": "/api/workspaces/[id]/index.js" },
    { "source": "/api/workspaces/:id/teams", "destination": "/api/workspaces/[id]/teams.js" },
    { "source": "/api/teams/:id/members", "destination": "/api/teams/[id]/members.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}